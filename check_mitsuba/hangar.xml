    <shape type="shapegroup" id="cube0">
        <shape type="cube">
            <transform name="to_world">
                <scale value=".5 .5 .5"/>
                <scale x="$side" y="$side" z="$side"/>
                <translate value="0 0 0"/>
            </transform>

            <ref id="white" name="bsdf"/>
        </shape>s
    </shape>

    <shape type="instance" id="c@0">
        <ref id="cube0" name="shape"/>
        <transform name="to_world">
            <translate value="0 0 0"/>
        </transform>
    </shape>

    <shape type="rectangle" id="background">
        <transform name="to_world">
            <scale value=".5 .5 .5"/>
            <scale x="$width" y="$length" z=".1"/>
        </transform>
        <bsdf type="diffuse">
            <rgb name="reflectance" value="0.6 0.4 0.2"/>
        </bsdf>
    </shape>

    <shape type="rectangle" id="reference">
        <transform name="to_world">
            <scale value=".5 .5 .5"/>
            <scale x="$width+2" y="$length+2" z=".1"/>
            <translate value="0 0 -0.1"/>
        </transform>
        <bsdf type="diffuse">
            <rgb name="reflectance" value="0.7 0 0"/>
        </bsdf>
    </shape>

</scene>