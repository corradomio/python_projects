<scene>
    <default name="side" value="0.15"/>
    <default name="width" value="12.0"/>
    <default name="length" value="80.0"/>

    <!-- integrator -->

    <integrator type="volpath">
        <integer name="max_depth" value="8"/>
    </integrator>

    <!-- sensor -->

    <sensor type="perspective" id="global-camera-wh">
        <vector x="20" z="4"/>

        <transform name="to_world">
            <!-- Move and rotate the camera so that looks from (1, 1, 1) to (1, 2, 1)
                and the direction (0, 0, 1) points "up" in the output image -->
            <lookat origin="30 50 10" target="-15 0 0" up="0, 0, 1"/>
        </transform>

        <sampler type="stratified">
            <integer name="sample_count" value="512"/>
        </sampler>

        <film type="hdrfilm">
            <string name="pixel_format" value="rgba"/>
            <integer name="width" value="1024"/>
            <integer name="height" value="1024"/>
        </film>
    </sensor>


